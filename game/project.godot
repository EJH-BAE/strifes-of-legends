; Engine configuration file.
config_version=5

[application]

config/name="Strifes of Legends"
config/version="0.6.4"
config/icon="res://art/icon.png"
boot_splash/bg_color=Color(0.031, 0.047, 0.09, 1)
boot_splash/show_image=true
boot_splash/image="res://art/boot.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="Strifes of Legends"

[autoload]

Settings="*res://scripts/settings.gd"
Sfx="*res://scripts/sfx.gd"
StrifeAcc="*res://scripts/account.gd"
Draft="*res://scripts/draft.gd"
SolNet="*res://scripts/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]

gdscript/warnings/inferred_variant=0
gdscript/warnings/inference_on_variant=0
gdscript/warnings/treat_warnings_as_errors=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
textures/default_filters/anisotropic_filtering_level=2
environment/ssao/quality=0
environment/ssil/quality=0
environment/glow/upscale_mode=0
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
textures/vram_compression/import_etc2_astc=true
