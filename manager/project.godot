; Engine configuration file.
config_version=5

[application]

config/name="Strife Manager"
config/version="0.6.4"
config/icon="res://art/mark.png"
boot_splash/bg_color=Color(0.012, 0.035, 0.09, 1)
boot_splash/show_image=true
boot_splash/image="res://art/mark.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
run/main_scene="res://manager.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="Strifes of Legends"

[display]

window/size/viewport_width=1100
window/size/viewport_height=680
window/size/window_width_override=1100
window/size/window_height_override=680

[debug]

gdscript/warnings/inferred_variant=0
gdscript/warnings/inference_on_variant=0
